; Engine configuration file.

config_version=5

[application]

config/name="Bergerie"
config/description="Jeu de gestion de moutons : protège ton troupeau des loups et collectionne les laines." #on verra + tard pour une meilleure description
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[autoload]

Game="*res://scripts/autoload/game.gd"

[display]
#pareil j ai réutilisé ce que j'ai vu ailleurs, pas sûre de garder ça.

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand" 
[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
